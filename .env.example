NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_ACCESS_TOKEN=sbp_...
# PDFs del Poder Judicial en Vercel Blob (store privado): lo usa el PC del estudio que los baja (scripts/pjud-download-docs.mts)
# y la app para servirlos (/api/pjud/doc/[id]). Vercel → Storage → Blob → token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Alertas diarias por correo (ruta /api/cron/alertas, cron de Vercel a las 08:00 de Chile de lunes a viernes)
CRON_SECRET=                    # el cron de Vercel lo manda como Authorization: Bearer
SUPABASE_SERVICE_ROLE_KEY=      # clave de servicio (solo servidor): el cron corre sin sesión de usuario
RESEND_API_KEY=                 # api.resend.com → API Keys
ALERT_EMAIL_TO=                 # ej: coordinacion@deudalibre.cl (varios separados por coma)
ALERT_EMAIL_FROM=               # ej: alertas@deudalibre.cl (dominio verificado en Resend)
